# Polyv
POLYV_APP_ID=your_app_id
POLYV_APP_SECRET=your_app_secret
POLYV_AI_ID=your_ai_id

# Server
PORT=8789
ALLOWED_ORIGINS=http://127.0.0.1:8788,https://your-domain.com
RATE_LIMIT=30
TOKEN_TTL_MS=600000
UPSTREAM_TIMEOUT_MS=30000
# 本地 curl 调试时打开；线上保持关闭
# ALLOW_NO_ORIGIN=1

# DeepSeek（二选一）
# DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_CREDENTIALS_FILE=/path/to/.credentials.yaml
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
